{
  "id": "prayer-acts",
  "name": "禱告日誌（敬拜・認罪・感謝・祈求）",
  "description": "照 ACTS 的順序禱告：先看神是誰，再認罪、感謝，最後才求。",
  "group": "與神同行",
  "order": 11,
  "when": "想好好禱告卻不知道說什麼，或發現自己的禱告只剩下「求」的時候。",
  "minutes": 8,
  "moods": [
    "平靜",
    "想親近神"
  ],
  "tags": [
    "禱告",
    "ACTS",
    "感恩",
    "代禱"
  ],
  "structure": "n-part",
  "reflection": "prayer",
  "flow": [
    "prayer",
    "confession",
    "gratitude",
    "people"
  ],
  "default_theme": "linen",
  "default_layout": "letter",
  "closing_label": "給主的話",
  "closing_hint": "今天想對主說的一段話。也可以換色。",
  "closing_placeholder": "親愛的主耶穌，今天…",
  "sections": [
    {
      "id": "adore",
      "title": "敬拜",
      "color": "#b5623c",
      "icon": "✦",
      "fields": [
        {
          "id": "attr",
          "label": "今天我想稱頌神的",
          "kind": "multi_choice",
          "options": [
            {
              "id": "o1",
              "label": "信實"
            },
            {
              "id": "o2",
              "label": "慈愛"
            },
            {
              "id": "o3",
              "label": "聖潔"
            },
            {
              "id": "o4",
              "label": "全能"
            },
            {
              "id": "o5",
              "label": "公義"
            },
            {
              "id": "o6",
              "label": "憐憫"
            },
            {
              "id": "o7",
              "label": "供應"
            },
            {
              "id": "o8",
              "label": "同在"
            }
          ],
          "ai_hint": "從選項挑作者自己說出的；沒有對得上的就不選。"
        },
        {
          "id": "because",
          "label": "因為",
          "kind": "short_text",
          "ai_hint": "用作者自己的話，一句以內；沒提到就留空。"
        }
      ]
    },
    {
      "id": "confess",
      "title": "認罪",
      "color": "#c8322c",
      "icon": "✝",
      "fields": [
        {
          "id": "sorry",
          "label": "想向主說對不起的事",
          "kind": "text",
          "hint": "看清楚就好，不用罵自己。",
          "ai_hint": "只寫作者自己承認的；不要替作者判斷對錯。"
        },
        {
          "id": "forgiven",
          "label": "我領受主的赦免了嗎？",
          "kind": "scale",
          "options": [
            {
              "id": "o1",
              "label": "領受了"
            },
            {
              "id": "o2",
              "label": "半信半疑"
            },
            {
              "id": "o3",
              "label": "還放不下"
            }
          ],
          "ai_hint": "作者自己評價了才選；不要替作者打分數。"
        }
      ]
    },
    {
      "id": "thanks",
      "title": "感謝",
      "color": "#1f7a4d",
      "icon": "🌱",
      "fields": [
        {
          "id": "list",
          "label": "感謝神的事",
          "kind": "list",
          "placeholder": "感謝神…",
          "min_rows": 3,
          "color": "#1f7a4d",
          "ai_hint": "一件一行，用作者的話；沒有就留空，不要湊數。"
        }
      ]
    },
    {
      "id": "ask",
      "title": "祈求",
      "color": "#2456b8",
      "icon": "🙏",
      "fields": [
        {
          "id": "me",
          "label": "為自己求",
          "kind": "list",
          "placeholder": "求主…",
          "ai_hint": "一件一行，用作者的話；沒有就留空，不要湊數。"
        },
        {
          "id": "others",
          "label": "為別人求",
          "kind": "list",
          "placeholder": "求主…",
          "ai_hint": "一件一行，用作者的話；沒有就留空，不要湊數。"
        },
        {
          "id": "time",
          "label": "今天禱告了多久",
          "kind": "choice",
          "options": [
            {
              "id": "o1",
              "label": "五分鐘內"
            },
            {
              "id": "o2",
              "label": "十分鐘左右"
            },
            {
              "id": "o3",
              "label": "二十分鐘以上"
            }
          ],
          "ai_hint": "只照作者自己說的選；沒提到就不選。"
        }
      ]
    }
  ]
