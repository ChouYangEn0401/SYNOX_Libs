        },
        {
          "id": "hard",
          "label": "一件難的事",
          "kind": "short_text",
          "ai_hint": "用作者自己的話，一句以內；沒提到就留空。"
        },
        {
          "id": "open",
          "label": "今天我願意分享到多深",
