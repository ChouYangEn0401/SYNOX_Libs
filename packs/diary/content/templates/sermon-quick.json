{
  "id": "sermon-quick",
  "name": "主日一分鐘回應",
  "description": "聚會結束前或回家路上：經文、一句話、勾回應、這週一件事。",
  "group": "與神同行",
  "order": 17,
  "default_hidden": true,
  "when": "沒空做完整筆記，但不想聽完就忘。",
  "minutes": 2,
  "moods": [
    "忙碌"
  ],
  "tags": [
    "講道",
    "主日",
    "教會",
    "勾選為主",
    "每週"
  ],
  "structure": "one-part",
  "reflection": "devotional",
  "flow": [
    "scripture",
    "quote",
    "plan"
  ],
  "default_theme": "letterpress",
  "default_layout": "postcard",
  "closing_label": "補充",
  "closing_hint": "還想記下來的。",
  "closing_placeholder": "另外…",
  "sections": [
    {
      "id": "one",
      "title": "今天的信息",
      "color": "#1f7a4d",
      "icon": "📖",
      "fields": [
        {
          "id": "passage",
          "label": "經文",
          "kind": "short_text",
          "placeholder": "例：書卷名 章:節",
          "ai_hint": "經文出處照作者寫的抄；沒有就留空，不要自己補經文。"
        },
        {
          "id": "quote",
          "label": "帶走的一句話",
          "kind": "short_text",
          "ai_hint": "用作者自己的話，一句以內；沒提到就留空。"
        },
        {
          "id": "kind",
          "label": "我要回應的是",
          "kind": "multi_choice",
          "options": [
            {
              "id": "o1",
              "label": "要順服"
            },
            {
              "id": "o2",
              "label": "要悔改"
            },
            {
              "id": "o3",
              "label": "要相信"
            },
            {
              "id": "o4",
              "label": "要感謝"
            },
            {
              "id": "o5",
              "label": "要去行動"
            },
            {
              "id": "o6",
              "label": "還要再想想"
            }
          ],
          "ai_hint": "從選項挑作者自己說出的；沒有對得上的就不選。"
        },
        {
          "id": "act",
          "label": "這週做的一件事",
          "kind": "short_text",
          "ai_hint": "用作者自己的話，一句以內；沒提到就留空。"
        }
      ]
    }
  ]
}
