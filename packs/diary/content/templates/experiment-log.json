              "label": "客群"
            },
            {
              "id": "o2",
              "label": "問題"
            },
            {
              "id": "o3",
              "label": "解法"
            },
            {
              "id": "o4",
              "label": "價格"
            },
            {
              "id": "o5",
              "label": "通路"
            }
          ],
          "ai_hint": "只照作者自己說的選；沒提到就不選。"
        },
        {
          "id": "sure",
          "label": "我的把握",
          "kind": "scale",
          "options": [
            {
              "id": "o1",
              "label": "很有把握"
            },
            {
              "id": "o2",
              "label": "五五波"
