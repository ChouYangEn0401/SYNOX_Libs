      "fields": [
        {
          "id": "line",
          "label": "一句話寫清楚",
          "kind": "fill",
          "pattern": "我相信 {} 會因為 {} 而 {}。",
          "ai_hint": "三格：哪一群人、因為什麼、會做出什麼行為。"
        },
        {
          "id": "kind",
          "label": "這是關於",
