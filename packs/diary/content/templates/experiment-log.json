{
  "id": "experiment-log",
  "name": "假設驗證紀錄",
  "description": "一次只驗一個假設：事前寫下怎樣算成立，事後回來對答案。",
  "group": "工作與創業",
  "order": 34,
  "default_hidden": true,
  "when": "要開始一個實驗（新功能、定價、通路、廣告）之前，以及結果出來之後。",
  "minutes": 10,
  "moods": [
    "冷靜",
    "不確定"
  ],
  "tags": [
    "工作",
    "創業",
    "決策"
  ],
  "structure": "three-part",
  "reflection": "reflection",
  "flow": [
    "work",
    "decision",
    "review",
    "plan"
  ],
  "default_theme": "letterpress",
  "default_layout": "ledger",
  "closing_label": "補充",
  "closing_hint": "還想記下來的。",
  "closing_placeholder": "另外…",
  "sections": [
